{
  "name": "@loom/cli",
  "version": "0.1.0",
  "description": "CLI for Loom agent platform — weave many agents and model providers into one workflow",
  "author": "Matheus Anzzulin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mathitos/agent-platform.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Mathitos/agent-platform/issues"
  },
  "homepage": "https://github.com/Mathitos/agent-platform#readme",
  "keywords": [
    "agent",
    "ai",
    "cli",
    "openai",
    "bionic",
    "local-ai",
    "tools",
    "automation",
    "chat",
    "assistant"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "loom": "./dist/bundle.js"
  },
  "files": [
    "dist/bundle.js",
    "dist/bundle.js.map"
  ],
  "publishConfig": {
    "dependencies": {}
  },
  "scripts": {
    "build": "tsc && node esbuild.config.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/bin.js",
    "prepack": "node scripts/prepare-pack.js",
    "postpack": "node scripts/restore-pack.js"
  },
  "dependencies": {
    "@loom/agent": "workspace:*",
    "@loom/core": "workspace:*",
    "@loom/providers": "workspace:*",
    "@loom/tools": "workspace:*",
    "@loom/workflow": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}